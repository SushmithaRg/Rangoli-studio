# Copy this file to .env and fill in your real values. Never commit the real .env file.

# PostgreSQL connection string.
# Local example:      postgresql://postgres:YOUR_PASSWORD@localhost:5432/rangoli_studio
# Neon/Supabase example: postgresql://user:password@host.neon.tech/rangoli_studio?sslmode=require
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/rangoli_studio

# A long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret

# How long a login session lasts, in minutes. 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
